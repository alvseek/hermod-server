# Resolved relative to the build context (the repo root).

# VCS
.git
**/.git
.gitignore
.gitattributes
.gitmodules
.github

# Virtual environments — including agent-memory-project/.venv (a WINDOWS venv
# (Lib/site-packages) and is both useless and heavy inside a Linux image).
.venv
**/.venv

# Python build/run artifacts
__pycache__
**/__pycache__
*.py[cod]
*.egg-info
.pytest_cache
.ruff_cache

# Runtime state — the project store arrives through the named volume, never
# through an image layer.
data

# Secrets and host-specific config.
.env
*.env
!*.env.example

# Not needed to build or run the server
tests
agent-memory-project/tests
agent-memory-project/plans
agent-memory-project/plan-templates
agent-memory-project/docs

# The container artifacts themselves
Dockerfile
.dockerignore
compose.yaml

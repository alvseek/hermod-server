# Hermod runtime settings - every HERMOD_* the server reads, shown at the values a local run
# uses. Local is the default shape: with no issuer configured the server binds loopback, asks
# nobody to log in, and refuses to start if anything says it is reachable from elsewhere. Set an
# issuer and it verifies tokens on the MCP face instead, which is the hosted shape. There is no
# mode to set - the issuer's presence is the switch.
#
#   uv run python -m hermod

# ---- Reachability -------------------------------------------------------------
# Bind address and port. Keep it on loopback - Hermod reads the working repository and is
# meant to run on the same machine as the agent. 8210, not Munnin's 8200: a coding client
# connects both servers and the two are meant to run side by side.
HERMOD_HOST=127.0.0.1
HERMOD_PORT=8210

# ---- Served content -----------------------------------------------------------
# The overlay to serve: the agent-memory-project submodule, read live on every request, so
# editing a procedure changes what is served with no re-import. Point it at a working tree
# under edit to serve that instead.
HERMOD_CONTENT_ROOT=agent-memory-project

# The storage backend document a served prompt composes onto, relative to the content root.
# The overlay ships two. `markdown.md` is live; this flips to `storage-backends/db.md` once
# the project store's mechanics exist, because a served client has no local store to compose
# markdown mechanics against.
HERMOD_BACKEND_DOC=storage-backends/db.md

# ---- Project store ------------------------------------------------------------
# Hermod's own store: project-keyed memory (context entries, the orientation map). Which engine
# it uses is a setting, because the two halves of the fleet need different ones: SQLite is the
# local and test path, Postgres is the deployed one.
#
# SQLite (the default). Keep it under data/ - that directory is gitignored, and the store has
# exactly one writer. The file stays in place as the rollback after a Postgres cutover, which is
# why it is still documented here.
HERMOD_DB_BACKEND=sqlite
HERMOD_DB_PATH=data/hermod.db

# Postgres (the deployed store). A second database on the instance the memory store lives on,
# not a schema inside it: the record is the munnin-deploy Postgres plan's decision 11, and it is
# what keeps two migration runners from writing one migration_history table. The DSN carries the
# password, so it is the one secret this server holds.
# HERMOD_DB_BACKEND=postgres
# HERMOD_DB_URL=postgresql://hermod:<password>@munnin-postgres:5432/hermod

# ---- Token verification (hosted) ----------------------------------------------
# Nothing below is a secret: a resource server verifies against a public JWKS and holds no
# client credential. Leaving the issuer unset is what keeps the server local - it is not a
# switch to remember, and a server with no issuer and a non-loopback URL refuses to start.

# The Logto tenant endpoint. Setting it turns the MCP face into a guarded surface.
# HERMOD_LOGTO_ENDPOINT=https://auth.lok.quest

# The accepted audiences, canonical first. Normally omitted: the audience binds itself to
# `<HERMOD_PUBLIC_BASE_URL>/mcp`, which is what a spec-following client asks for. Set it when the
# registered identifier differs from that URL, or while a rename means two identifiers are live at
# once - comma-separated, and empty entries are ignored.
# HERMOD_LOGTO_AUDIENCE=https://hermod.lok.quest/mcp

# This server's own public URL, and therefore the resource identifier a client is sent to log in
# for. It must match the API resource registered with Logto character for character, or every token
# minted for it is refused as invalid_target.
# HERMOD_PUBLIC_BASE_URL=https://hermod.lok.quest

# Only for the container shape, and only with no issuer: bind 0.0.0.0 while something in front
# (compose.yaml publishes the port on the host's loopback) keeps the port local. It is an
# acknowledgement, never a detection - never set it on a process anything outside can reach.
# HERMOD_LOCAL_BIND_ALL=1
